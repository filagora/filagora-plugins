{
    "name": "filagora/filagora-plugins",
    "description": "Plugins for Filagora: a library of plugins and releases with moderation, reports, subscriptions and archiving, as a Filament plugin.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "filagora",
        "plugins"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "filagora/filagora-core": "^0.2.2"
    },
    "require-dev": {
        "filagora/filagora-forums": "^0.6",
        "filagora/filagora-search": "^0.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Filagora\\Plugins\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filagora\\Plugins\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filagora\\Plugins\\PluginsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
